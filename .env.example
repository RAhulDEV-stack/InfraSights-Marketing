# ==============================================================================
# Infrasights v2.10 — Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env and populate with production secrets prior to deployment.
# All sensitive values must be injected securely via PaaS secrets or key vault.

# ------------------------------------------------------------------------------
# 1. Server & Host Configuration
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=production
CUSTOM_DOMAIN=infrasights.in
APP_URL=https://infrasights.in

# ------------------------------------------------------------------------------
# 2. Authentication, Session & Token Security
# ------------------------------------------------------------------------------
JWT_SECRET=your_production_jwt_secret_key_minimum_32_characters_random
JWT_EXPIRES_IN=7d
SESSION_SECRET=your_production_session_signing_secret_replace_in_prod
COOKIE_DOMAIN=.infrasights.in
SECURE_COOKIES=true

# ------------------------------------------------------------------------------
# 3. Vendor Administration & Management API
# ------------------------------------------------------------------------------
# Vendor secret key used for programmatic X-Vendor-Key / X-Admin-Key authentication
VENDOR_SECRET_KEY=your_secure_vendor_secret_key_here
# Dedicated vendor administrator login credentials
VENDOR_ADMIN_EMAIL=admin@infrasights.in
VENDOR_ADMIN_PASSWORD=your_secure_vendor_admin_password_here

# ------------------------------------------------------------------------------
# 4. Persistence Tier — Microsoft SQL Server (TDS / Port 1433)
# ------------------------------------------------------------------------------
# Set active credentials to connect to Azure SQL, AWS RDS for SQL Server, or self-hosted MSSQL.
# When port 1433 is unreachable, the engine gracefully activates the in-memory fallback store.
DB_SERVER=your-mssql-server.database.windows.net
DB_PORT=1433
DB_NAME=infrasights_production
DB_USER=infrasights_sa
DB_PASSWORD=your_secure_mssql_password_here
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false

# ------------------------------------------------------------------------------
# 5. Email & Notification Microservice / SMTP Transport
# ------------------------------------------------------------------------------
# Destination address for administrator notifications when deployment requests arrive
ADMIN_NOTIFICATION_EMAIL=admin@infrasights.in
FROM_EMAIL=admin@infrasights.in

# Option A: GoDaddy Workspace / Microsoft 365 SMTP (matches infrasights.in MX)
# SMTP_HOST=smtpout.secureserver.net
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=admin@infrasights.in
# SMTP_PASS=your_admin_email_password_here

# Option B: Resend API (RECOMMENDED FOR NETLIFY SERVERLESS - Zero port/firewall issues)
# Get a free key at https://resend.com (3,000 emails/month free)
# RESEND_API_KEY=re_your_resend_api_key_here
# RESEND_FROM=Infrasights <admin@infrasights.in>

# Option C: Gmail / Google Workspace SMTP
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_16_character_app_password

# ------------------------------------------------------------------------------
# 6. Enterprise Rate Limiting & CORS Policies
# ------------------------------------------------------------------------------
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000
ALLOWED_ORIGINS=https://infrasights.in,https://www.infrasights.in

# ------------------------------------------------------------------------------
# 7. Mobile SMS Gateway Provider (Optional - for Real Physical Handset Delivery)
# ------------------------------------------------------------------------------
# In local development without credentials, OTPs log to server console and
# automatically dispatch to the registrant's email from admin@infrasights.in.
#
# Option A: 2Factor.in (RECOMMENDED FOR INDIA - 100% ZERO DLT REQUIRED)
# Register at https://2factor.in with mobile + email (no business registration/GST needed).
# Get 15 free trial credits instantly; delivers via shared banking header (TFCTOR).
# TWOFACTOR_API_KEY=your_2factor_api_key_here
#
# Option B: Fast2SMS (India +91)
# Copy API Key from https://www.fast2sms.com/dashboard/dev-api (Dev API tab, ignore DLT tab).
# Route 'q' (Quick SMS) requires NO DLT approval.
# FAST2SMS_API_KEY=your_fast2sms_api_key_here
# FAST2SMS_ROUTE=q
#
# Option C: Twilio (Global carrier delivery for international numbers)
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
# TWILIO_PHONE_NUMBER=+1234567890
#
# Option D: MSG91 (Indian DLT-approved enterprise SMS gateway)
# MSG91_AUTH_KEY=your_msg91_auth_key_here
# MSG91_TEMPLATE_ID=your_dlt_approved_template_id
